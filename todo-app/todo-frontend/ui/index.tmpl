<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{{.Title}}
		</title>
		<link rel="stylesheet" href="/static/css/main.css">
	</head>
	<body>
		<div class="content-container">
			<div class="header-group">
				<h1>
					{{.Title}}
				</h1>
				<p class="message">
					{{.Message}}
				</p>
			</div>
			{{if .Image}}
			<img src="{{.Image}}" alt="Dynamic App Image" class="app-image">
			{{else}}
			<p class="no-image">
				No image available.
			</p>
			{{end}}
			<form class="todo-form" id="taskForm" data-url="{{ .BackendURL }}">
				<input type="text" name="title" id="taskTitle" class="todo-input" placeholder="What needs to be done? (max 140 characters)" maxlength="140" required >
				<button type="submit" class="todo-btn">
					Add Task
				</button>
			</form>
			<ul class="todo-list">
				{{range .Tasks}}
				<li class="todo-item">
					{{Print .}}
				</li>
				{{end}}
			</ul>
			<div class="health-status" id="healthStatus">
				Checking backend health...
			</div>
			<div class="break-btn-container">
				<button type="button" class="break-btn" id="breakAppBtn">
					Break App
				</button>
			</div>
			<footer>
				<strong>DevOps with Kubernetes 2026</strong>
			</footer>
		</div>
		<script src='/static/js/main.js' type='text/javascript'>
		</script>
	</body>
</html>
